# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - SISTEMA DE TRIAGEM VRE
# Copie este arquivo para .env e ajuste os caminhos conforme sua infraestrutura.
# Se nenhuma variável for definida, os caminhos padrão relativos serão utilizados.
# ==============================================================================

# Diretório base da aplicação (padrão: raiz do repositório)
# VRE_BASE_DIR=/opt/triagem_vre
# VRE_BASE_DIR=C:\Sistemas\Triagem_VRE

# Diretórios customizados (opcional)
# VRE_DATABASE_DIR=database
# VRE_TRIAGEM_DB_PATH=database/triagem_vre.db
# VRE_CEP_DB_PATH=database/cep_areas.db
# VRE_ENTRADA_CSV_DIR=entrada_csv
# VRE_PLANILHAS_ANTERIORES_DIR=planilhas_anteriores
# VRE_TEMPLATES_DIR=templates
# VRE_OUTPUT_XLSX_PATH=Planilha_Controle_VRE_Ativa.xlsx

# Nível de Log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
VRE_LOG_LEVEL=INFO
